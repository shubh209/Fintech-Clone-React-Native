{
  "compilerOptions": {
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "skipLibCheck": true,
    "strict": false,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./apps/frontend/src/*"
      ],
      "@assets/*": [
        "./apps/frontend/assets/*"
      ],
      "@shared/*": [
        "./packages/shared/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "global.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "extends": "expo/tsconfig.base"
}
